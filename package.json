{
  "name": "@local/dsh-plugin-sandbox-escalation-clamp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hide and repair sandbox escalation arguments for sessions that can never escalate.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
